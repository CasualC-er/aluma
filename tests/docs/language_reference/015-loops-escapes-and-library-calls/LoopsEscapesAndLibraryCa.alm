proc countWords(text: String): int
  var parts: ref array of String;
  var i: int;
  var n: int;
begin
  parts := split(text, " ");
  i := 0;
  n := 0;
  while i < len(parts) do
    if len(parts[i]) = 0 then
      i := i + 1;
      next;
    end;
    n := n + 1;
    i := i + 1;
    if n = 100 then
      exit;
    end;
  end;
  return n;
end;

proc start(): int
begin
  writeLine("tab:\t| quote:\" | smile: \u{1F600}");
  assert(countWords("a  b c") = 3);
  return band(0xFF, 0x0F);
end;
